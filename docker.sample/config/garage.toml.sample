metadata_dir = "/var/lib/garage/meta"
data_dir = "/var/lib/garage/blocks"
db_engine = "sqlite"
replication_factor = 1

rpc_bind_addr = "[::]:3901"
rpc_public_addr = "127.0.0.1:3901"
# generate rpc_secret
# > openssl rand -hex 32
rpc_secret = "your_rpc_secret_here"

[s3_api]
s3_region = "garage"
api_bind_addr = "[::]:3900"
root_domain = ".s3.localhost"

[admin]
api_bind_addr = "[::]:3903"
# generate admin_token
# > openssl rand -hex 32
admin_token = "your_admin_token_here"
